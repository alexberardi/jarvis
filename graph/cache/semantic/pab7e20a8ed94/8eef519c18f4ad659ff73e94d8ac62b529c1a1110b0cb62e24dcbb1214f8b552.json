{"nodes": [{"id": "jarvis_server_docs_cc_13_mobile_chat_inbox_settings", "label": "CC spec 13: Mobile chat, inbox, callbacks, household settings", "file_type": "document", "source_file": "jarvis-server/docs/cc/13-mobile-chat-inbox-settings.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "jarvis_server_docs_cc_13_mobile_chat_inbox_settings_mobile_chat_sse", "label": "POST /mobile/chat SSE stream", "file_type": "concept", "source_file": "jarvis-server/docs/cc/13-mobile-chat-inbox-settings.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Frozen SSE schema (status, acknowledgment, delta, done, error); every stream ends with exactly one done or error; one write plus flush per event because clients drop events split across chunks."}, {"id": "jarvis_server_docs_cc_13_mobile_chat_inbox_settings_fake_word_streaming", "label": "Fake word-by-word streaming replay (D32)", "file_type": "concept", "source_file": "jarvis-server/docs/cc/13-mobile-chat-inbox-settings.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Kept exactly with 20 ms per word because the text path needs the complete output to parse tool calls; real token streaming deferred to the prompt-provider redesign."}, {"id": "jarvis_server_docs_cc_13_mobile_chat_inbox_settings_notify_service", "label": "In-process notify service (inbox + push) (D31)", "file_type": "concept", "source_file": "jarvis-server/docs/cc/13-mobile-chat-inbox-settings.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Producers write the inbox row in the same SQLite transaction as their own state; push goes on the durable queue with retries."}, {"id": "jarvis_server_docs_cc_13_mobile_chat_inbox_settings_interactive_callbacks", "label": "Interactive callbacks (node plane and server plane)", "file_type": "concept", "source_file": "jarvis-server/docs/cc/13-mobile-chat-inbox-settings.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Anti-vanishing rule: a callback job never stays pending; ownership errors are 404 not 403 to avoid leaking job existence."}, {"id": "jarvis_server_docs_cc_13_mobile_chat_inbox_settings_household_settings_allowlist", "label": "Household settings allowlist (HOUSEHOLD_CONTROLLABLE_SETTINGS)", "file_type": "concept", "source_file": "jarvis-server/docs/cc/13-mobile-chat-inbox-settings.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The allowlist is the security boundary; allowlist check precedes role check so probing gets 404."}, {"id": "jarvis_server_docs_cc_13_mobile_chat_inbox_settings_dispatch_node_command", "label": "dispatch_node_command (headless node tool execution)", "file_type": "concept", "source_file": "jarvis-server/docs/cc/13-mobile-chat-inbox-settings.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "jarvis_server_docs_cc_13_mobile_chat_inbox_settings_node_actions_route", "label": "POST /nodes/{id}/actions", "file_type": "concept", "source_file": "jarvis-server/docs/cc/13-mobile-chat-inbox-settings.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "jarvis_server_docs_cc_13_mobile_chat_inbox_settings_node_notification_routes", "label": "/node/inbox-item, /node/push-notification, /node/send-link (public plugin API)", "file_type": "concept", "source_file": "jarvis-server/docs/cc/13-mobile-chat-inbox-settings.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "jarvis_server_docs_cc_13_mobile_chat_inbox_settings_attention_broker_gate", "label": "Attention broker